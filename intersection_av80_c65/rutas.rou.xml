<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" maxSpeed="13.89"/>

    <!-- Rutas Avenida 80 -->
    <route id="route_N_S" edges="N_in S_out"/>
    <route id="route_S_N" edges="S_in N_out"/>

    <!-- Rutas Calle 65 -->
    <route id="route_E_W" edges="E_in W_out"/>
    <route id="route_W_E" edges="W_in E_out"/>

    <!-- Rutas de giro a la derecha desde calle 65 -->
    <route id="route_E_N" edges="E_in N_out"/>
    <route id="route_W_S" edges="W_in S_out"/>

    <!-- Flujos Avenida 89  -->
    <flow id="flow_NS" route="route_N_S" begin="0" end="3600" vehsPerHour="600"/>
    <flow id="flow_SN" route="route_S_N" begin="0" end="3600" vehsPerHour="600"/>

    <!-- Flujos Calle 65 recto -->
    <flow id="flow_EW" route="route_E_W" begin="0" end="3600" vehsPerHour="400"/>
    <flow id="flow_WE" route="route_W_E" begin="0" end="3600" vehsPerHour="400"/>

    <!-- Flujos de giro a la derecha desde calle 65 -->
    <flow id="flow_EN" route="route_E_N" begin="0" end="3600" vehsPerHour="100"/>
    <flow id="flow_WS" route="route_W_S" begin="0" end="3600" vehsPerHour="100"/>
</routes>